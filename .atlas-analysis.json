  "keyFeatures": [
    "Wallet Confidence Score (WCS) engine that classifies buyer sessions and routes them to resolved, partial, or anonymous checkout flows",
    "Stateful session orchestration API (v7) with SSE and WebSocket transport based on session mode",
    "VCI field evaluation to USDC stablecoin payment bridge with GPS-tagged offline sync",
    "Escrow acceptance flow for high-value transactions with legal compliance checkpoints",
    "OpenClaw AI agent swarm (10+ worker classes) for intelligent procurement automation",
    "Local-first vector store for WCS profiles, contract rules, translations, and entitlements",
    "Procurement Express webhook integration with HMAC signature verification",
    "Multi-chain USDC settlement on Base, Arbitrum, Polygon, and Ethereum"
  ],
  "publicApiSurface": [
    "POST /api/v7/orchestrate",
    "GET /api/v7/sessions/{id}/prefill",
    "POST /api/v7/sessions/{id}/escrow-accept",
    "POST /api/v7/sessions/{id}/transition",
    "POST /api/v7/sessions/{id}/funding-method",
    "POST /webhooks/procurement",
    "POST /mods/procurement_wallet/usdc/request",
    "GET /mods/procurement_wallet/usdc/watch/{paymentId}",
    "POST /mods/procurement_wallet/usdc/manual-confirm",
    "WCSEngine.score(signals) → WCSResult",
    "VCIProcureNetBridge.handleSyncEvent(event) → PaymentRequest"
  ]
}
